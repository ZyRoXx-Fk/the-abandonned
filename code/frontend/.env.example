# Backend origin, without /api/auth. Frontend and API must use the same site for cookies.
PUBLIC_API_BASE_URL=http://localhost:3000

# Optional public MCP endpoint overrides. Never include secrets in these URLs.
# Empty values use https://relay-backend-latest.onrender.com/mcp for both roles.
# The copied EN/FR prompts link to the public repository setup guide; pairing stays private.
PUBLIC_MCP_CLIENT_URL=
PUBLIC_MCP_BUSINESS_URL=
