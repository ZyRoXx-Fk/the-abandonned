# Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/relay_test?retryWrites=true&w=majority
TEST_MONGODB_URI=
# Optional: point the standalone negative-check integration test at a local MongoDB 8 mongod binary.
TEST_MONGOD_BINARY=
# Generate a strong random secret (for example: openssl rand -hex 32).
JWT_SECRET=
